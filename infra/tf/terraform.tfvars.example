aws_region  = "us-east-1"
project_name = "dcfly"
environment  = "prod"
owner        = "kevin-yang"

db_name     = "dcfly"
db_username = "dcfly"
db_password = "replace-with-a-strong-db-password"

jwt_secret  = "replace-with-at-least-32-random-characters"
fmp_api_key = "replace-with-your-fmp-api-key"

github_repository   = "https://github.com/YOUR_USERNAME/YOUR_REPO"
